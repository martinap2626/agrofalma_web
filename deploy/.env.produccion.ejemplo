# Plantilla para el servidor real. Copiar como .env en la raíz del proyecto y completar. Nunca subir .env al repositorio.
SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrofalma_bd
DB_USER=agrofalma_app  # usuario con permisos mínimos, creado con: flask permisos-bd   (NO root)
DB_PASSWORD=
SESSION_COOKIE_SECURE=true   # el sistema debe abrirse por HTTPS
CONFIAR_EN_PROXY=true        # true solo si hay nginx (u otro proxy de confianza) delante
SESION_INACTIVIDAD_MIN=30
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
LOG_ARCHIVO=logs/agrofalma.log

# --- Respaldos (ver deploy/POLITICA_RESPALDO.md) ---
RESPALDO_CLAVE=              # clave para cifrar los respaldos; guárdala TAMBIÉN fuera del servidor (sin ella no se pueden restaurar)
RESPALDO_COPIA_DIR=          # carpeta fuera del servidor: disco externo, unidad de red o carpeta sincronizada con la nube

# --- Reglas del negocio y límites ---
DESCUENTO_MAX_TRABAJADOR_PCT=10   # descuento máximo (%) que un Trabajador puede dar sin autorización del Administrador
EXPORT_MAX_POR_VENTANA=10         # máximo de reportes CSV por usuario en la ventana de tiempo
EXPORT_VENTANA_MIN=10

# --- Procesos de gunicorn (opcional; ver deploy/gunicorn.conf.py) ---
WORKERS=2
HILOS=4
