# Plantilla para el servidor real. Copiar como .env en la raíz del proyecto y completar. Nunca subir .env al repositorio.
SECRET_KEY=            # python -c "import secrets; print(secrets.token_hex(32))"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrofalma_bd
DB_USER=agrofalma_app  # usuario con permisos solo sobre agrofalma_bd, NO root
DB_PASSWORD=
SESSION_COOKIE_SECURE=true   # el sistema debe abrirse por HTTPS
CONFIAR_EN_PROXY=true        # true solo si hay nginx (u otro proxy de confianza) delante
SESION_INACTIVIDAD_MIN=30
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
LOG_ARCHIVO=logs/agrofalma.log
