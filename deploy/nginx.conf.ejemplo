# Sitio de nginx (Linux) con HTTPS. Reemplazar el dominio y las rutas de los certificados (por ejemplo con certbot).
server {
    listen 80;
    server_name sistema.ejemplo.pe;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sistema.ejemplo.pe;
    ssl_certificate     /etc/letsencrypt/live/sistema.ejemplo.pe/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sistema.ejemplo.pe/privkey.pem;

    client_max_body_size 5m;

    location /static/ {
        alias /opt/agrofalma/agrofalma_web/app/static/;
        expires 7d;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
