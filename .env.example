# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.

# Clave de firma de sesiones y tokens CSRF. OBLIGATORIA: sin ella la aplicación no arranca.
# Genera una larga y aleatoria, por ejemplo:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrofalma_bd
DB_USER=agrofalma_app
DB_PASSWORD=

# --- Seguridad (opcionales; estos son los valores por defecto) ---
# Minutos de inactividad antes de cerrar la sesión automáticamente
SESION_INACTIVIDAD_MIN=30
# Intentos de acceso fallidos permitidos antes del bloqueo temporal, y duración de la ventana en minutos
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
# En el servidor de producción (con HTTPS) poner true: la cookie de sesión solo viajará cifrada
SESSION_COOKIE_SECURE=false
# Poner true SOLO si hay un proxy inverso de confianza (nginx, etc.) delante de la aplicación
CONFIAR_EN_PROXY=false
# Archivo donde se guardan los errores de la aplicación
LOG_ARCHIVO=logs/agrofalma.log
