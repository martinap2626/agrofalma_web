# Copia este archivo como .env y completa los valores. El archivo .env NUNCA se sube al repositorio.

# Clave de firma de sesiones y tokens CSRF. OBLIGATORIA: sin ella la aplicación no arranca.
# Genera una larga y aleatoria, por ejemplo:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=agrofalma_bd
DB_USER=agrofalma_app
DB_PASSWORD=

# Cuentas de MySQL aparte (opcionales; si faltan se usa DB_USER). Recomendado: tres cuentas con permisos distintos.
#   DB_USER / DB_PASSWORD            la aplicación web (permisos mínimos, creada con: flask permisos-bd)
#   DB_RESPALDO_USER / _PASSWORD     solo lectura (SELECT, SHOW VIEW, TRIGGER, EVENT): la usa el volcado (respaldar-bd)
#   DB_ADMIN_USER / _PASSWORD        administración: restaurar, simulacro de recuperación, cambios de estructura y pruebas
DB_RESPALDO_USER=
DB_RESPALDO_PASSWORD=
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# --- Seguridad (opcionales; estos son los valores por defecto) ---
# Minutos de inactividad antes de cerrar la sesión automáticamente
SESION_INACTIVIDAD_MIN=30
# Intentos de acceso fallidos permitidos antes del bloqueo temporal, y duración de la ventana en minutos
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15
# En el servidor de producción (con HTTPS) poner true: la cookie de sesión solo viajará cifrada
SESSION_COOKIE_SECURE=false
# Poner true SOLO si hay un proxy inverso de confianza (nginx, etc.) delante de la aplicación
CONFIAR_EN_PROXY=false
# Archivo donde se guardan los errores de la aplicación
LOG_ARCHIVO=logs/agrofalma.log

# --- Respaldos de la base de datos (opcionales; ver deploy/POLITICA_RESPALDO.md) ---
# Clave para cifrar los respaldos. Si la dejas vacía se guardan sin cifrar. Guárdala también fuera de este equipo.
RESPALDO_CLAVE=
# Carpeta FUERA de este disco (disco externo, unidad de red o carpeta sincronizada con la nube) para una segunda copia
RESPALDO_COPIA_DIR=

# --- Reglas del negocio y límites (opcionales; estos son los valores por defecto) ---
# Descuento máximo (%) que un Trabajador puede dar sobre el precio de lista sin autorización del Administrador
DESCUENTO_MAX_TRABAJADOR_PCT=10
# Máximo de reportes CSV que un usuario puede descargar en la ventana de tiempo (minutos)
EXPORT_MAX_POR_VENTANA=10
EXPORT_VENTANA_MIN=10
